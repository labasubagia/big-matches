FOOTBALL_DATA_API_KEY=your_key_here
# TheSportsDB (free tier): key "123", no signup. Only used when DATA_PROVIDER=thesportsdb.
THESPORTSDB_API_KEY=123
# Fixture environment: "development" (default) and "production" use real data;
# "mock" loads test fixtures (public/fixtures.mock.json), set automatically by e2e/run.ts.
VITE_FIXTURES=development
# Absolute site URL (canonical links + structured data). Trailing slash optional.
VITE_SITE_URL=https://labasubagia.github.io/big-matches
