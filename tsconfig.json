{
	"compilerOptions": {
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"target": "ES2024",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"skipLibCheck": true,
		"strict": true,
		"strictNullChecks": true,
		"types": ["node", "vite/client"]
	},
	"include": ["src", "vite.config.ts"]
}
