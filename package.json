{
	"name": "big-matches",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/ensure-fixtures.mjs && vite dev",
		"build": "node scripts/ensure-fixtures.mjs && vite build && node scripts/generate-sw.mjs && tsc --noEmit",
		"preview": "vite preview",
		"test": "vitest run --exclude \"e2e/**\"",
		"check": "biome check",
		"format": "biome format --write",
		"test:e2e": "node e2e/run.mjs",
		"data:gen": "node scripts/generate-data.mjs",
		"prepare": "husky"
	},
	"dependencies": {
		"@radix-ui/react-accordion": "^1.3.1",
		"@radix-ui/react-avatar": "^1.3.1",
		"@radix-ui/react-popover": "^1.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"fuse.js": "^7.5.0",
		"lucide-react": "^1.63.0",
		"react": "^19.0.0",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@playwright/test": "^1.64.1",
		"@types/node": "^22.5.4",
		"@types/react": "^19.0.8",
		"@types/react-dom": "^19.0.3",
		"@vitejs/plugin-react": "^6.1.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"typescript": "^5.9.0",
		"vite": "^8.0.14",
		"vitest": "^5.0.5"
	},
	"lint-staged": {
		"*": "biome check --staged --no-errors-on-unmatched"
	}
}
