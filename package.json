{
	"name": "big-matches",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/ensure-fixtures.ts && vite dev",
		"build": "node scripts/ensure-fixtures.ts && vite build && node scripts/generate-sw.ts && tsc --noEmit",
		"preview": "vite preview",
		"test": "vitest run --exclude \"e2e/**/*.spec.ts\"",
		"check": "biome check",
		"format": "biome format --write",
		"test:e2e": "node e2e/run.ts",
		"data:gen": "node scripts/provider/index.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"@radix-ui/react-accordion": "^1.3.1",
		"@radix-ui/react-avatar": "^1.3.1",
		"@radix-ui/react-popover": "^1.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.68.0",
		"minisearch": "^7.2.0",
		"react": "^19.0.0",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@lhci/cli": "^0.16.0",
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.6",
		"@types/react": "^19.0.8",
		"@types/react-dom": "^19.0.3",
		"@vitejs/plugin-react": "^6.2.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"sharp": "^0.35.5",
		"typescript": "^5.9.0",
		"vite": "^8.0.14",
		"vitest": "^5.1.0",
		"workbox-build": "^7.4.1"
	},
	"lint-staged": {
		"*": "biome check --staged --no-errors-on-unmatched"
	}
}
